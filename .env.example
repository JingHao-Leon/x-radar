# ==== X Radar 配置（复制为 .env 或直接 export）====

# 服务监听
XR_HOST=127.0.0.1
XR_PORT=8787
# 数据目录（SQLite + 截图）
XR_DATA_DIR=./data

# 轮询间隔（秒，下限 30）。演示可 60；7x24 挂机建议 ≥300。
# 触发 X 限流(429)时自动全局指数退避 5→10→20→30→60 分钟，恢复后逐级回落
XR_POLL_INTERVAL=60

# 访问 X 的代理：auto=自动读 HTTPS_PROXY/系统代理；off=直连；或显式 http://127.0.0.1:7890
XR_PROXY=auto

# API/推送令牌（设置后插件与 API 需带 X-Radar-Token 头；留空则不鉴权，仅本机使用）
XR_TOKEN=

# LLM 摘要（OpenAI 兼容接口：Kimi/DeepSeek/OpenAI 等）。留空则使用内置规则摘要
XR_LLM_BASE_URL=
XR_LLM_API_KEY=
XR_LLM_MODEL=

# 截图浏览器：headless=无头；也可用 CDP 接管本机已开调试端口的浏览器
XR_HEADLESS=1
# XR_CDP_ENDPOINT=http://127.0.0.1:9222

# 每条推文最多抓取的外部链接页数
XR_MAX_PAGES=3
