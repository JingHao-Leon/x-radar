{
  "manifest_version": 3,
  "name": "X Radar 监控助手",
  "description": "在 x.com 上采集监控名单内作者的推文推送到 X Radar 服务器，并轮询新推文提供桌面提醒。",
  "version": "0.1.0",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Radar 监控助手"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x.js"],
      "run_at": "document_idle"
    }
  ]
}
